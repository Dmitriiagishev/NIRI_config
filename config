# Take a look at the mako manpage with the command:
#   man 5 mako
# To view all configuration options.

#font=Cozette 11
format=<b>%a ⏵</b> %s\n%b
sort=-time
output=DP-2
layer=overlay
anchor=top-right
background-color=#01545d
width=300
height=150
margin=5
padding=0,5,10
border-size=5
border-color=#41a4ad
border-radius=15
max-icon-size=64
default-timeout=5000
ignore-timeout=1

[urgency=normal]
border-color=#41a4ad

[urgency=high]
border-color=#41a4ad
default-timeout=0

[app-name=lightcord]
border-color=#41a4ad

[summary~="log-.*"]
border-color=#41a4ad

[app-name=lightcord summary~="(.*(^| )orz|ORZ|sto|STO|otl|OTL( |$).*)"]
invisible=1
